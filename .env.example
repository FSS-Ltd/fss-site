# Primary lead store
HUBSPOT_ACCESS_TOKEN=

# Optional custom HubSpot contact property names for non-standard fields
HUBSPOT_CHALLENGE_PROPERTY=
HUBSPOT_SOURCE_CONTEXT_PROPERTY=
HUBSPOT_SOURCE_PATH_PROPERTY=
HUBSPOT_RESOURCE_SLUG_PROPERTY=

# Transactional email provider (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
LEAD_NOTIFICATION_EMAIL=

# Public site URL used in outbound links and email templates
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Client-side submission transport (api or netlify)
NEXT_PUBLIC_LEAD_SUBMISSION_PROVIDER=api
