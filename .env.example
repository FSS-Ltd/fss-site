# Anthropic API key — required for automated blog post generation
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Primary lead store
HUBSPOT_ACCESS_TOKEN=
# Optional legacy alias supported by server env loader:
# HUBSPOT_API_KEY=

# Optional custom HubSpot contact property names for non-standard fields
HUBSPOT_CHALLENGE_PROPERTY=
HUBSPOT_SOURCE_CONTEXT_PROPERTY=
HUBSPOT_SOURCE_PATH_PROPERTY=
HUBSPOT_RESOURCE_SLUG_PROPERTY=

# Transactional email provider (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
LEAD_NOTIFICATION_EMAIL=

# Public canonical site URL used in metadata and outbound links.
# Recommended:
# - local: http://localhost:3000
# - preview: leave unset (Netlify URL/DEPLOY_PRIME_URL fallback is used), or set explicitly
# - production: set to your live domain
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Client-side submission transport (api or netlify)
NEXT_PUBLIC_LEAD_SUBMISSION_PROVIDER=api

# Google Analytics 4 measurement ID
# Example: G-KZ7H3DMCSY
NEXT_PUBLIC_GA_MEASUREMENT_ID=
