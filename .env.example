# Anthropic API key - required for automated blog post generation
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Primary lead store
HUBSPOT_ACCESS_TOKEN=
# Optional legacy alias supported by server env loader:
# HUBSPOT_API_KEY=

# Optional custom HubSpot contact property names for non-standard fields
HUBSPOT_CHALLENGE_PROPERTY=
HUBSPOT_SOURCE_CONTEXT_PROPERTY=
HUBSPOT_SOURCE_PATH_PROPERTY=
HUBSPOT_RESOURCE_SLUG_PROPERTY=

# Transactional email provider (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
RESEND_WEBHOOK_SECRET=
LEAD_NOTIFICATION_EMAIL=

# Public canonical site URL used in metadata and outbound links.
# Recommended:
# - local: http://localhost:3000
# - preview: leave unset (VERCEL_URL fallback is used), or set explicitly
# - production: set to your live domain
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Analytics 4 measurement ID
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Growth OS server-only configuration
DATABASE_URL=
# Operator and migration tooling only. Do not set in Vercel request runtimes.
DIRECT_DATABASE_URL=
AUTH_SECRET=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=
GROWTH_OS_OWNER_EMAIL=j.ntagengwa@faithfulsoftware.dev
TOKEN_ENCRYPTION_KEY=
GROWTH_OS_AUTOMATIONS_ENABLED=false

# Shared secret required on inbound requests to the cron dispatch endpoint
CRON_SECRET=

# HMAC key used to authenticate signed research-agent ingestion requests (min 32 chars)
GROWTH_OS_AGENT_HMAC_SECRET=

# HMAC key used to sign/verify newsletter unsubscribe links (min 32 chars)
NEWSLETTER_UNSUBSCRIBE_TOKEN_SECRET=

# Vercel Blob read/write token for approved email visual assets
BLOB_READ_WRITE_TOKEN=

# Operations portal availability is independent from worker activation.
OPERATIONS_ENABLED=false
# Production cutover flags. Keep all false until the reviewed Studio rollout.
OPERATIONS_PORTAL_PREFIX_FREE_ENABLED=false
OPERATIONS_FSS_STUDIO_ENABLED=false
OPERATIONS_GROWTH_OPERATIONS_CUTOVER_ENABLED=false
OPERATIONS_ONBOARDING_ENABLED=false
OPERATIONS_SIGNING_ENABLED=false
OPERATIONS_BILLING_ENABLED=false
# Dedicated least-privilege connections for the respective workers.
OPERATIONS_ONBOARDING_DATABASE_URL=
OPERATIONS_SIGNING_DATABASE_URL=
OPERATIONS_BILLING_DATABASE_URL=
STRIPE_MODE=test
STRIPE_ACCOUNT_ID=
# Server-only key; prefer a restricted key with account-read permission.
STRIPE_SECRET_KEY=
# Optional for future embedded payment UI; hosted links do not use this key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Reviewed Stripe portal configuration: method updates/history only, no subscription changes.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
# Dedicated Operations endpoint secret, bound to the same Stripe account and mode.
OPERATIONS_STRIPE_WEBHOOK_SECRET=
