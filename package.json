{
  "name": "fss-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint && npm run lint:covers",
    "lint:covers": "tsx scripts/validate-blog-covers.ts",
    "test:unit": "find lib components app scripts \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -print0 | xargs -0 node --import tsx --test",
    "test:integration:growth:database": "find tests/integration/growth -name '*.test.ts' ! -name 'preview-contract.test.ts' -print0 | xargs -0 node --import tsx --test --test-concurrency=1",
    "test:integration:growth:database:ci": "tsx scripts/require-growth-database-env.ts && pnpm test:integration:growth:database",
    "test:integration:growth:preview": "node --import tsx --test tests/integration/growth/preview-contract.test.ts",
    "test:integration:growth": "pnpm test:integration:growth:database && pnpm test:integration:growth:preview",
    "test:coverage:growth": "tsx scripts/require-growth-database-env.ts && find lib components app scripts tests/integration/growth \\( -name '*.test.ts' -o -name '*.test.tsx' \\) ! -name 'preview-contract.test.ts' -print0 | xargs -0 node --import tsx --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='lib/growth/**/*.ts' --test-coverage-include='app/api/growth/**/*.ts' --test-coverage-include='app/api/agent/**/*.ts' --test-coverage-include='app/api/cron/**/*.ts' --test-coverage-include='app/api/integrations/**/*.ts' --test-coverage-include='app/api/webhooks/**/*.ts' --test-coverage-include='app/api/newsletter/**/*.ts' --test-coverage-exclude='**/*.test.ts' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80",
    "test:growth": "pnpm test:unit && pnpm test:integration:growth",
    "test": "pnpm test:growth",
    "test:public-redesign": "node scripts/validate-public-redesign-shell.mjs",
    "test:visual": "playwright test",
    "generate-blog-post": "tsx scripts/generate-blog-post.ts",
    "growth:research:weekday": "tsx scripts/run-scheduled-research-agent.ts",
    "growth:seo-audits:daily": "tsx scripts/run-scheduled-seo-audit-agent.ts",
    "growth:previews:backfill": "tsx scripts/backfill-prospect-previews.ts",
    "growth:previews:backfill-pr": "tsx scripts/backfill-prospect-preview-pr.ts",
    "growth:previews:reconcile-bespoke": "tsx scripts/reconcile-bespoke-prospect-previews.ts",
    "growth:previews:trigger-current-ten-drafts": "tsx scripts/trigger-current-ten-prospect-preview-drafts.ts",
    "growth:previews:trigger-current-ten": "tsx scripts/trigger-current-ten-prospect-preview-pr.ts",
    "growth:previews:trigger-evidence-refresh": "tsx scripts/trigger-current-thirteen-evidence-refresh.ts",
    "perf:budget:homepage": "node scripts/check-homepage-budget.mjs",
    "perf:lighthouse:mobile": "lhci autorun --config=.lighthouserc.mobile.json",
    "verify:growth-release": "tsx scripts/verify-growth-release.ts",
    "verify:migrations": "tsx scripts/verify-migrations.ts",
    "verify:fss-studio-coverage": "tsx scripts/verify-fss-studio-screen-coverage.ts",
    "typecheck": "tsc --noEmit",
    "test:public-site": "node --import tsx --test tests/integration/public-site-crawl.test.ts",
    "generate:readiness-kit": "tsx scripts/generate-readiness-kit.ts",
    "test:integration:operations": "tsx scripts/require-operations-database-env.ts && node --import tsx --test --test-concurrency=1 tests/integration/operations/*.test.ts",
    "test:coverage:operations": "tsx scripts/require-operations-database-env.ts && node --import tsx --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='lib/operations/**/*.ts' --test-coverage-exclude='**/*.test.ts' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 lib/operations/**/*.test.ts tests/integration/operations/*.test.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.2",
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@vercel/blob": "2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.7.0",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.72.0",
    "reading-time": "^1.5.0",
    "resend": "^6.20.0",
    "sharp": "0.35.4",
    "stripe": "22.6.1",
    "svix": "^1.99.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.6",
      "browserslist": "4.28.7",
      "js-yaml@^3.13.0": "3.15.2",
      "baseline-browser-mapping": "2.11.0"
    }
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "packageManager": "pnpm@9.7.0+sha512.dc09430156b427f5ecfc79888899e1c39d2d690f004be70e05230b72cb173d96839587545d09429b55ac3c429c801b4dc3c0e002f653830a420fa2dd4e3cf9cf"
}
